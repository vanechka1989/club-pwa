    "@aws-sdk/s3-request-presigner": "^3.1139.0",
    "@club/shared": "workspace:*",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "bun-types": "^1.1.14",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
