{
  "name": "club-pwa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @club/api --filter @club/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test -c playwright.full.config.ts",
    "test:e2e:release": "playwright test -c playwright.release.config.ts",
    "test:e2e:devices": "playwright test -c playwright.device.config.ts",
    "db:generate": "pnpm --filter @club/api db:generate",
    "db:migrate": "pnpm --filter @club/api db:migrate",
    "db:seed": "pnpm --filter @club/api db:seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "axe-core": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.18",
      "shell-quote": "1.9.0"
    }
  }
}
